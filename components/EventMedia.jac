import from "@jac/runtime" { Link }
import from .ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }
import from "@hugeicons/react" { HugeiconsIcon }
import from "@hugeicons/core-free-icons" { Home01Icon, Calendar01Icon }

def:pub EventMedia() -> JsxElement {
    return <div className="min-h-screen bg-muted/40"><div className="mx-auto flex min-h-screen max-w-[1440px]"><aside className="hidden w-64 shrink-0 flex-col border-r bg-card px-5 py-6 md:flex"><Link to="/" className="mb-9 flex items-center gap-3 px-1"><span className="flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5" /></span><span><span className="block font-semibold">Schoolhouse</span><span className="block text-xs text-muted-foreground">Family portal</span></span></Link><nav className="flex flex-col gap-1"><Link to="/" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Overview</Link><Link to="/students" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Students</Link><Link to="/progress" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning progress</Link><Link to="/homework" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Homework</Link><Link to="/calendar" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Calendar</Link><Link to="/notices" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Notices</Link><Link to="/messages" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Messages</Link><Link to="/profiles" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Profiles</Link><Link to="/materials" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning materials</Link><Link to="/event-media" className="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-medium text-primary">Event media</Link></nav></aside><main className="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-9 lg:py-8"><header className="mb-8"><Link to="/" className="flex items-center gap-2 font-semibold md:hidden"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5 text-primary" />Schoolhouse</Link><p className="text-sm text-muted-foreground">Oakwood Primary · Shared with Maya’s family</p></header><div className="mb-6"><p className="text-sm font-medium text-primary">School community</p><h1 className="mt-1 text-3xl font-semibold tracking-tight">Event media</h1><p className="mt-1 text-sm text-muted-foreground">Photos and videos from class activities and school celebrations.</p></div><Card className="shadow-sm"><CardHeader><CardTitle>Shared moments</CardTitle><CardDescription>Media approved for this student’s authorised family members</CardDescription></CardHeader><CardContent><div className="flex min-h-72 flex-col items-center justify-center rounded-2xl border border-dashed bg-muted/30 p-8 text-center"><div className="mb-4 flex size-14 items-center justify-center rounded-2xl bg-primary/10 text-primary"><HugeiconsIcon icon={Calendar01Icon} strokeWidth={2} className="size-7" /></div><h2 className="text-lg font-semibold">No event photos yet</h2><p className="mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">When teachers share approved photos or videos from school events, they’ll appear here for Maya’s family.</p><Link to="/calendar" className="mt-5 rounded-lg border bg-card px-4 py-2 text-sm font-medium hover:bg-muted">See upcoming events</Link></div></CardContent></Card><div className="mt-5 rounded-xl border bg-card p-5"><h2 className="font-medium">A note about student privacy</h2><p className="mt-1 text-sm text-muted-foreground">Event media is intended for the authorised family and school team. Please do not redistribute photos of other students.</p></div></main></div></div>;
}
