import from "@jac/runtime" { Link }


import from .ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }
import from "@hugeicons/react" { HugeiconsIcon }
import from "@hugeicons/core-free-icons" { Home01Icon, Notification01Icon }

def:pub SchoolNotices() -> JsxElement {
    return <div className="min-h-screen bg-muted/40"><div className="mx-auto flex min-h-screen max-w-[1440px]"><aside className="hidden w-64 shrink-0 flex-col border-r bg-card px-5 py-6 md:flex"><Link to="/" className="mb-9 flex items-center gap-3 px-1"><span className="flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5" /></span><span><span className="block font-semibold">Schoolhouse</span><span className="block text-xs text-muted-foreground">Family portal</span></span></Link><nav className="flex flex-col gap-1"><Link to="/" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Overview</Link><Link to="/progress" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning progress</Link><Link to="/homework" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Homework</Link><Link to="/calendar" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Calendar</Link><Link to="/notices" className="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-medium text-primary">Notices</Link><Link to="/messages" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Messages</Link><Link to="/profiles" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Profiles</Link><Link to="/materials" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning materials</Link><Link to="/event-media" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Event media</Link></nav></aside><main className="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-9 lg:py-8"><header className="mb-8"><Link to="/" className="flex items-center gap-2 font-semibold md:hidden"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5 text-primary" />Schoolhouse</Link><p className="text-sm text-muted-foreground">Oakwood Primary · Grade 3</p></header><div className="mb-6"><p className="text-sm font-medium text-primary">School communication</p><h1 className="mt-1 text-3xl font-semibold tracking-tight">Notices</h1><p className="mt-1 text-sm text-muted-foreground">Important updates, reminders, and dates for Maya’s class.</p></div><div className="grid gap-4 lg:grid-cols-2"><Card className="shadow-sm"><CardHeader><CardTitle>Grade 3 weekly update</CardTitle><CardDescription>Ms. Chen · 17 October · Acknowledgement needed</CardDescription></CardHeader><CardContent><p className="text-sm leading-relaxed">Our class is exploring plants and their life cycles this week. Please send a small, labelled container for Friday’s seed-growing activity.</p><div className="mt-4 flex flex-wrap items-center justify-between gap-3 border-t pt-4"><span className="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-900">Please acknowledge</span><button className="rounded-lg border px-3 py-2 text-sm font-medium hover:bg-muted">Acknowledge notice</button></div></CardContent></Card><Card className="shadow-sm"><CardHeader><CardTitle>Reading morning</CardTitle><CardDescription>School office · 14 October · Event reminder</CardDescription></CardHeader><CardContent><p className="text-sm leading-relaxed">Families are welcome to join the Grade 3 reading circle on Wednesday morning. Students may bring one favourite book to share.</p><div className="mt-4 border-t pt-4 text-sm text-muted-foreground">Wednesday, 19 October · 9:00 am · School library</div></CardContent></Card><Card className="shadow-sm"><CardHeader><CardTitle>Assessment week</CardTitle><CardDescription>Grade 3 team · 10 October</CardDescription></CardHeader><CardContent><p className="text-sm leading-relaxed">Short reading and mathematics check-ins will take place next week. These activities help teachers plan the right support for each student.</p></CardContent></Card><Card className="border-dashed shadow-sm"><CardContent className="flex min-h-48 flex-col items-center justify-center text-center"><HugeiconsIcon icon={Notification01Icon} strokeWidth={2} className="mb-3 size-8 text-primary" /><p className="font-medium">Private family notices</p><p className="mt-1 max-w-sm text-sm text-muted-foreground">School updates are visible only to authorised families and staff connected with this student.</p></CardContent></Card></div></main></div></div>;
}
