import from "@jac/runtime" { Link, Navigate }
import from .ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }

def:pub StudentRoster() -> JsxElement {
    has selected: str = "Maya Patel";
    has role: str = "";
    async can with entry {
        saved_role = sessionStorage.getItem("schoolhouse_demo_role");
        role = saved_role or "Parent";
    }
    if role == "" { return <main className="min-h-screen bg-muted/40 p-8"><p className="text-sm text-muted-foreground">Loading role…</p></main>; }
    if role != "Teacher" { return <Navigate to="/" replace={True} />; }
    selected_id = "03121" if selected == "Maya Patel" else "03122" if selected == "Noah Williams" else "03123" if selected == "Ava Johnson" else "03124" if selected == "Ethan Chen" else "03125";
    homework_count = "8 of 10" if selected == "Maya Patel" else "9 of 10" if selected == "Noah Williams" else "7 of 10" if selected == "Ava Johnson" else "10 of 10" if selected == "Ethan Chen" else "6 of 10";
    attendance = "5 of 5 days" if selected == "Maya Patel" or selected == "Ethan Chen" else "4 of 5 days" if selected == "Noah Williams" else "5 of 5 days" if selected == "Ava Johnson" else "3 of 5 days";
    focus = "Subtraction" if selected == "Maya Patel" else "Reading fluency" if selected == "Noah Williams" else "Spelling patterns" if selected == "Ava Johnson" else "Extension work" if selected == "Ethan Chen" else "Number facts";
    math_width = "w-[72%]" if selected == "Maya Patel" else "w-[84%]" if selected == "Noah Williams" else "w-[65%]" if selected == "Ava Johnson" else "w-[94%]" if selected == "Ethan Chen" else "w-[58%]";
    language_width = "w-[84%]" if selected == "Maya Patel" else "w-[68%]" if selected == "Noah Williams" else "w-[76%]" if selected == "Ava Johnson" else "w-[88%]" if selected == "Ethan Chen" else "w-[62%]";
    science_width = "w-[66%]" if selected == "Maya Patel" else "w-[74%]" if selected == "Noah Williams" else "w-[82%]" if selected == "Ava Johnson" else "w-[71%]" if selected == "Ethan Chen" else "w-[57%]";
    task_title = "Subtraction practice" if selected == "Maya Patel" else "Read aloud for 15 minutes" if selected == "Noah Williams" else "Weekly spelling list" if selected == "Ava Johnson" else "Science journal" if selected == "Ethan Chen" else "Number facts practice";
    task_subject = "Mathematics" if selected == "Maya Patel" or selected == "Ethan Chen" or selected == "Sofia Garcia" else "Language";
    due_day = "19 October" if selected == "Maya Patel" or selected == "Ava Johnson" else "20 October" if selected == "Noah Williams" or selected == "Sofia Garcia" else "21 October";
    task_state = "Pending" if selected == "Maya Patel" or selected == "Ava Johnson" or selected == "Sofia Garcia" else "Started" if selected == "Noah Williams" else "Ready for review";
    second_task = "Read chapter four" if selected == "Maya Patel" else "Plant life-cycle notes" if selected == "Noah Williams" else "Read chapter three" if selected == "Ava Johnson" else "Maths challenge" if selected == "Ethan Chen" else "Shape patterns";
    observation = "benefits from short, guided practice at home" if selected == "Maya Patel" else "is building confidence with regular reading practice" if selected == "Noah Williams" else "works carefully and is practising spelling patterns" if selected == "Ava Johnson" else "is ready for more challenging extension tasks" if selected == "Ethan Chen" else "is strengthening number facts with daily practice";

    return <div className="min-h-screen bg-muted/40"><div className="mx-auto flex min-h-screen max-w-[1440px]"><aside className="hidden w-64 shrink-0 flex-col border-r bg-card px-5 py-6 md:flex"><Link to="/" className="mb-8 flex items-center gap-3"><span className="flex size-10 items-center justify-center rounded-xl bg-primary font-semibold text-primary-foreground">S</span><span><span className="block font-semibold">Schoolhouse</span><span className="block text-xs text-muted-foreground">Teacher workspace</span></span></Link><nav className="flex flex-col gap-1"><Link to="/" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Overview</Link><Link to="/students" className="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-medium text-primary">Students</Link><Link to="/progress" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning progress</Link><Link to="/homework" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Homework</Link><Link to="/calendar" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Calendar</Link><Link to="/notices" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Notices</Link><Link to="/messages" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Messages</Link><Link to="/profiles" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Profiles</Link><Link to="/materials" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning materials</Link><Link to="/event-media" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Event media</Link></nav></aside><main className="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-9"><header className="mb-7 flex items-center justify-between"><Link to="/" className="font-semibold md:hidden">Schoolhouse</Link><p className="text-sm text-muted-foreground">Oakwood Primary · Grade 3 · Room 12</p></header><div className="mb-6"><p className="text-sm font-medium text-primary">Teacher workspace</p><h1 className="mt-1 text-3xl font-semibold tracking-tight">Student roster</h1><p className="mt-1 text-sm text-muted-foreground">Choose a student to review their own profile, progress, and assignments.</p></div><div className="grid gap-5 xl:grid-cols-3"><Card className="shadow-sm"><CardHeader><CardTitle>My students</CardTitle><CardDescription>Grade 3 · 5 students</CardDescription></CardHeader><CardContent className="flex flex-col gap-2"><button onClick={lambda { selected = "Maya Patel"; }} className={"rounded-lg border p-3 text-left " + ("border-primary bg-primary/10" if selected == "Maya Patel" else "bg-card hover:bg-muted/50")}>Maya Patel <span className="block text-xs text-muted-foreground">Grade 3 · Room 12 · 03121</span></button><button onClick={lambda { selected = "Noah Williams"; }} className={"rounded-lg border p-3 text-left " + ("border-primary bg-primary/10" if selected == "Noah Williams" else "bg-card hover:bg-muted/50")}>Noah Williams <span className="block text-xs text-muted-foreground">Grade 3 · Room 12 · 03122</span></button><button onClick={lambda { selected = "Ava Johnson"; }} className={"rounded-lg border p-3 text-left " + ("border-primary bg-primary/10" if selected == "Ava Johnson" else "bg-card hover:bg-muted/50")}>Ava Johnson <span className="block text-xs text-muted-foreground">Grade 3 · Room 12 · 03123</span></button><button onClick={lambda { selected = "Ethan Chen"; }} className={"rounded-lg border p-3 text-left " + ("border-primary bg-primary/10" if selected == "Ethan Chen" else "bg-card hover:bg-muted/50")}>Ethan Chen <span className="block text-xs text-muted-foreground">Grade 3 · Room 12 · 03124</span></button><button onClick={lambda { selected = "Sofia Garcia"; }} className={"rounded-lg border p-3 text-left " + ("border-primary bg-primary/10" if selected == "Sofia Garcia" else "bg-card hover:bg-muted/50")}>Sofia Garcia <span className="block text-xs text-muted-foreground">Grade 3 · Room 12 · 03125</span></button></CardContent></Card><div className="flex flex-col gap-5 xl:col-span-2"><Card className="overflow-hidden shadow-sm"><div className="h-2 bg-gradient-to-r from-amber-300 via-emerald-400 to-sky-400" /><CardHeader><CardTitle>{selected}</CardTitle><CardDescription>Student ID {selected_id} · Grade 3 · Room 12 · Oakwood Primary · Academic year 2024–25</CardDescription></CardHeader><CardContent><div className="grid gap-3 sm:grid-cols-3"><div className="rounded-xl bg-emerald-50 p-4"><p className="text-xs font-medium text-emerald-800">Assignments complete</p><p className="mt-1 text-2xl font-semibold text-emerald-950">{homework_count}</p></div><div className="rounded-xl bg-sky-50 p-4"><p className="text-xs font-medium text-sky-800">Attendance</p><p className="mt-1 text-2xl font-semibold text-sky-950">{attendance}</p></div><div className="rounded-xl bg-amber-50 p-4"><p className="text-xs font-medium text-amber-800">Practice focus</p><p className="mt-1 font-semibold text-amber-950">{focus}</p></div></div></CardContent></Card><div className="grid gap-5 md:grid-cols-2"><Card className="shadow-sm"><CardHeader><CardTitle>Subject progress</CardTitle><CardDescription>{selected} · current learning levels</CardDescription></CardHeader><CardContent className="flex flex-col gap-4"><div className="rounded-xl bg-amber-50 p-3"><p className="font-medium text-amber-950">Mathematics</p><div className="mt-2 h-2 rounded-full bg-white"><div className={"h-2 rounded-full bg-amber-400 " + math_width} /></div><p className="mt-2 text-xs text-amber-900">Focus: {focus}.</p></div><div className="rounded-xl bg-sky-50 p-3"><p className="font-medium text-sky-950">Language</p><div className="mt-2 h-2 rounded-full bg-white"><div className={"h-2 rounded-full bg-sky-400 " + language_width} /></div><p className="mt-2 text-xs text-sky-900">Reading and writing progress for {selected}.</p></div><div className="rounded-xl bg-emerald-50 p-3"><p className="font-medium text-emerald-950">Science</p><div className="mt-2 h-2 rounded-full bg-white"><div className={"h-2 rounded-full bg-emerald-400 " + science_width} /></div><p className="mt-2 text-xs text-emerald-900">Class activities and practical work.</p></div></CardContent></Card><Card className="shadow-sm"><CardHeader><CardTitle>Homework & support</CardTitle><CardDescription>Assignments for {selected}</CardDescription></CardHeader><CardContent className="flex flex-col gap-3"><div className="rounded-lg border p-3"><p className="font-medium">{task_title}</p><p className="text-xs text-muted-foreground">{task_subject} · assigned this week</p><p className="mt-1 text-xs text-amber-800">{task_state} · Due {due_day}</p></div><div className="rounded-lg border p-3"><p className="font-medium">{second_task}</p><p className="text-xs text-muted-foreground">Additional class assignment</p><p className="mt-1 text-xs text-sky-800">Review with student</p></div><div className="rounded-xl bg-emerald-50 p-3"><p className="text-xs font-semibold text-emerald-900">Teacher observation</p><p className="mt-1 text-sm text-emerald-950">{selected} {observation}.</p></div></CardContent></Card></div></div></div></main></div></div>;
}
