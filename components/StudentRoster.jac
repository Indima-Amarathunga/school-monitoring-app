import from .ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }

def:pub StudentRoster() -> JsxElement {
    has selected: str = "Maya Patel";
    return <main className="min-h-screen bg-muted/40 px-4 py-6 sm:px-8"><div className="mx-auto max-w-6xl"><p className="text-sm text-muted-foreground">Oakwood Primary · Grade 3 · Room 12</p><p className="mt-6 text-sm font-medium text-primary">Teacher workspace</p><h1 className="mt-1 text-3xl font-semibold">Student roster</h1><p className="mt-1 text-sm text-muted-foreground">Select a student to see progress and homework.</p><div className="mt-6 grid gap-5 lg:grid-cols-3"><Card className="shadow-sm"><CardHeader><CardTitle>My students</CardTitle><CardDescription>Grade 3 · 5 students</CardDescription></CardHeader><CardContent className="flex flex-col gap-2"><button onClick={lambda { selected = "Maya Patel"; }} className="rounded-lg border bg-primary/10 p-3 text-left">Maya Patel <span className="block text-xs text-muted-foreground">Grade 3 · Room 12 · 03121</span></button><button onClick={lambda { selected = "Noah Williams"; }} className="rounded-lg border p-3 text-left">Noah Williams <span className="block text-xs text-muted-foreground">Grade 3 · Room 12 · 03122</span></button><button onClick={lambda { selected = "Ava Johnson"; }} className="rounded-lg border p-3 text-left">Ava Johnson <span className="block text-xs text-muted-foreground">Grade 3 · Room 12 · 03123</span></button><button onClick={lambda { selected = "Ethan Chen"; }} className="rounded-lg border p-3 text-left">Ethan Chen <span className="block text-xs text-muted-foreground">Grade 3 · Room 12 · 03124</span></button><button onClick={lambda { selected = "Sofia Garcia"; }} className="rounded-lg border p-3 text-left">Sofia Garcia <span className="block text-xs text-muted-foreground">Grade 3 · Room 12 · 03125</span></button></CardContent></Card><div className="flex flex-col gap-5 lg:col-span-2"><Card className="shadow-sm"><CardHeader><CardTitle>{selected}</CardTitle><CardDescription>Grade 3 · Room 12 · Oakwood Primary</CardDescription></CardHeader><CardContent><div className="grid gap-3 sm:grid-cols-3"><div className="rounded-xl bg-emerald-50 p-4"><p className="text-xs font-medium text-emerald-800">Homework complete</p><p className="mt-1 text-2xl font-semibold text-emerald-950">8 of 10</p></div><div className="rounded-xl bg-sky-50 p-4"><p className="text-xs font-medium text-sky-800">Attendance</p><p className="mt-1 text-2xl font-semibold text-sky-950">5 of 5 days</p></div><div className="rounded-xl bg-amber-50 p-4"><p className="text-xs font-medium text-amber-800">Practice focus</p><p className="mt-1 font-semibold text-amber-950">Subtraction</p></div></div></CardContent></Card><div className="grid gap-5 md:grid-cols-2"><Card className="shadow-sm"><CardHeader><CardTitle>Subject progress</CardTitle></CardHeader><CardContent className="flex flex-col gap-4"><div className="rounded-xl bg-amber-50 p-3"><p className="font-medium text-amber-950">Mathematics · Building confidence</p><div className="mt-2 h-2 rounded-full bg-white"><div className="h-2 w-[72%] rounded-full bg-amber-400" /></div><p className="mt-2 text-xs text-amber-900">Practise subtraction with borrowing.</p></div><div className="rounded-xl bg-sky-50 p-3"><p className="font-medium text-sky-950">Language · On track</p><div className="mt-2 h-2 rounded-full bg-white"><div className="h-2 w-[84%] rounded-full bg-sky-400" /></div><p className="mt-2 text-xs text-sky-900">Reading aloud is a strength.</p></div><div className="rounded-xl bg-emerald-50 p-3"><p className="font-medium text-emerald-950">Science · Growing well</p><div className="mt-2 h-2 rounded-full bg-white"><div className="h-2 w-[66%] rounded-full bg-emerald-400" /></div><p className="mt-2 text-xs text-emerald-900">Curious during practical activities.</p></div></CardContent></Card><Card className="shadow-sm"><CardHeader><CardTitle>Homework & support</CardTitle><CardDescription>Assignments to check in on</CardDescription></CardHeader><CardContent className="flex flex-col gap-3"><div className="rounded-lg border p-3"><p className="font-medium">Subtraction practice</p><p className="text-xs text-muted-foreground">Mathematics · Exercises 1–10</p><p className="mt-1 text-xs text-amber-800">Pending · Due 19 October</p></div><div className="rounded-lg border p-3"><p className="font-medium">Read chapter four</p><p className="text-xs text-muted-foreground">Language · The Garden Path</p><p className="mt-1 text-xs text-sky-800">Started · Due 21 October</p></div><div className="rounded-xl bg-emerald-50 p-3"><p className="text-xs font-semibold text-emerald-900">Teacher observation</p><p className="mt-1 text-sm text-emerald-950">{selected} benefits from short, guided practice at home.</p></div></CardContent></Card></div></div></div></div></main>;
}
