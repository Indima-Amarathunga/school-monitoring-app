import from "@jac/runtime" { Link }
import from .ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }
import from "@hugeicons/react" { HugeiconsIcon }
import from "@hugeicons/core-free-icons" { Home01Icon, BookOpen01Icon }

def:pub LearningMaterials() -> JsxElement {
    return <div className="min-h-screen bg-muted/40"><div className="mx-auto flex min-h-screen max-w-[1440px]"><aside className="hidden w-64 shrink-0 flex-col border-r bg-card px-5 py-6 md:flex"><Link to="/" className="mb-9 flex items-center gap-3 px-1"><span className="flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5" /></span><span><span className="block font-semibold">Schoolhouse</span><span className="block text-xs text-muted-foreground">Family portal</span></span></Link><nav className="flex flex-col gap-1"><Link to="/" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Overview</Link><Link to="/students" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Students</Link><Link to="/progress" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning progress</Link><Link to="/homework" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Homework</Link><Link to="/calendar" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Calendar</Link><Link to="/notices" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Notices</Link><Link to="/messages" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Messages</Link><Link to="/profiles" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Profiles</Link><Link to="/materials" className="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-medium text-primary">Learning materials</Link><Link to="/event-media" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Event media</Link></nav></aside><main className="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-9 lg:py-8"><header className="mb-8"><Link to="/" className="flex items-center gap-2 font-semibold md:hidden"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5 text-primary" />Schoolhouse</Link><p className="text-sm text-muted-foreground">Shared by Ms. Chen · Grade 3</p></header><div className="mb-6"><p className="text-sm font-medium text-primary">Practice at home</p><h1 className="mt-1 text-3xl font-semibold tracking-tight">Learning materials</h1><p className="mt-1 text-sm text-muted-foreground">Teacher-selected reading and practice resources for Maya.</p></div><div className="mb-5 flex flex-wrap gap-2"><span className="rounded-full bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary">All resources · 2</span><span className="rounded-full border bg-card px-3 py-1.5 text-xs text-muted-foreground">Mathematics · 1</span><span className="rounded-full border bg-card px-3 py-1.5 text-xs text-muted-foreground">Language · 1</span></div><div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3"><Card className="shadow-sm"><CardHeader><div className="mb-2 flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary"><HugeiconsIcon icon={BookOpen01Icon} strokeWidth={2} className="size-5" /></div><CardTitle>Subtraction with borrowing</CardTitle><CardDescription>Mathematics · Practice sheet · PDF</CardDescription></CardHeader><CardContent><p className="text-sm leading-relaxed text-muted-foreground">Ten carefully paced exercises for practising regrouping. Try a few together and ask Maya to explain each step.</p><div className="mt-4 flex items-center justify-between border-t pt-4"><span className="text-xs text-muted-foreground">Shared 16 October · Ms. Chen</span><a href="mailto:teacher@oakwood.example?subject=Subtraction%20practice%20sheet" className="rounded-lg border px-3 py-2 text-sm font-medium hover:bg-muted">Request file</a></div></CardContent></Card><Card className="shadow-sm"><CardHeader><div className="mb-2 flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary"><HugeiconsIcon icon={BookOpen01Icon} strokeWidth={2} className="size-5" /></div><CardTitle>The Garden Path · Chapter 4</CardTitle><CardDescription>Language · Guided reading · Video</CardDescription></CardHeader><CardContent><p className="text-sm leading-relaxed text-muted-foreground">A short read-along to support fluent reading and story retelling. Pause to talk about new words.</p><div className="mt-4 flex items-center justify-between border-t pt-4"><span className="text-xs text-muted-foreground">Shared 15 October · Ms. Chen</span><a href="mailto:teacher@oakwood.example?subject=Garden%20Path%20reading%20video" className="rounded-lg border px-3 py-2 text-sm font-medium hover:bg-muted">Request video</a></div></CardContent></Card></div><div className="mt-5 rounded-xl border border-dashed bg-card p-5"><p className="font-medium">Need another resource?</p><p className="mt-1 text-sm text-muted-foreground">Ask Ms. Chen to share practice material for a topic Maya is working on.</p><Link to="/messages" className="mt-3 inline-flex rounded-lg bg-primary px-3 py-2 text-sm font-medium text-primary-foreground">Message Ms. Chen</Link></div></main></div></div>;
}
