sv import from ..services.schoolService { SchoolEvent, get_school_dashboard, add_school_event }
import from "@jac/runtime" { Link }
import from .ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }
import from .ui.button { Button }
import from "@hugeicons/react" { HugeiconsIcon }
import from "@hugeicons/core-free-icons" { Home01Icon, Calendar01Icon, Add01Icon }

def:pub SchoolCalendar() -> JsxElement {
    has events: list[SchoolEvent] = [];
    has role: str = "Parent";
    has title: str = "";
    has event_date: str = "";
    has details: str = "";
    has message: str = "";
    has loading: bool = True;
    async can with entry {
        dashboard = await get_school_dashboard();
        events = dashboard["events"] as list[SchoolEvent];
        loading = False;
    }
    async def save_event {
        if not title.strip() or not event_date.strip() { message = "Enter an event title and date."; return; }
        created = await add_school_event(title, event_date, details, "teacher-demo");
        if created {
            events = events + [created];
            title = "";
            event_date = "";
            details = "";
            message = "Event added to the calendar.";
        } else { message = "Only an authorized teacher profile can add events."; }
    }
    return <div className="min-h-screen bg-muted/40"><div className="mx-auto flex min-h-screen max-w-[1440px]"><aside className="hidden w-64 shrink-0 flex-col border-r bg-card px-5 py-6 md:flex"><Link to="/" className="mb-9 flex items-center gap-3 px-1"><span className="flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5" /></span><span><span className="block font-semibold">Schoolhouse</span><span className="block text-xs text-muted-foreground">Family portal</span></span></Link><nav className="flex flex-col gap-1"><Link to="/" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Overview</Link><Link to="/progress" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning progress</Link><Link to="/homework" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Homework</Link><Link to="/calendar" className="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-medium text-primary">Calendar</Link><Link to="/notices" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Notices</Link><Link to="/messages" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Messages</Link><Link to="/profiles" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Profiles</Link><Link to="/materials" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning materials</Link><Link to="/event-media" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Event media</Link></nav></aside><main className="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-9 lg:py-8"><header className="mb-8 flex flex-wrap items-center justify-between gap-4"><Link to="/" className="flex items-center gap-2 font-semibold md:hidden"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5 text-primary" />Schoolhouse</Link><label className="flex items-center gap-2 text-sm text-muted-foreground">Viewing as<select value={role} onChange={lambda (e: ChangeEvent) { role = e.target.value; }} className="h-9 rounded-lg border bg-card px-3 text-foreground"><option>Parent</option><option>Teacher</option></select></label></header><div className="mb-6"><p className="text-sm font-medium text-primary">Oakwood Primary · Academic year 2024–25</p><h1 className="mt-1 text-3xl font-semibold tracking-tight">Calendar & events</h1><p className="mt-1 text-sm text-muted-foreground">School dates and student birthdays in one shared calendar.</p></div><div className="grid gap-5 lg:grid-cols-5"><Card className="shadow-sm lg:col-span-3"><CardHeader><CardTitle>Upcoming dates</CardTitle><CardDescription>Events and birthdays for the school community</CardDescription></CardHeader><CardContent className="flex flex-col gap-3">{loading and <p className="py-6 text-center text-sm text-muted-foreground">Loading calendar…</p>}{not loading and len(events) == 0 and <div className="rounded-xl border border-dashed px-4 py-10 text-center"><HugeiconsIcon icon={Calendar01Icon} strokeWidth={2} className="mx-auto mb-3 size-8 text-primary" /><p className="font-medium">No school events yet</p><p className="mt-1 text-sm text-muted-foreground">Student birthdays and school dates will appear here.</p></div>}{for ev in events {<div key={jid(ev)} className="flex items-center gap-4 rounded-xl border bg-card p-4"><div className="flex size-12 shrink-0 flex-col items-center justify-center rounded-lg bg-primary/10 text-xs font-semibold text-primary"><span>{ev.event_date}</span></div><div><h2 className="font-medium">{ev.title}</h2><p className="text-sm text-muted-foreground">{ev.details}</p></div></div>}}</CardContent></Card><div className="flex flex-col gap-4"><Card className="shadow-sm"><CardHeader><CardTitle>Birthday calendar</CardTitle><CardDescription>Added from student profiles</CardDescription></CardHeader><CardContent><div className="rounded-xl bg-muted/50 p-4"><p className="font-medium">Maya Patel</p><p className="mt-1 text-sm text-muted-foreground">12 March · Grade 3</p></div><p className="mt-3 text-xs text-muted-foreground">Keep birthdays up to date by updating the student profile.</p></CardContent></Card>{role == "Teacher" and <Card className="shadow-sm"><CardHeader><CardTitle>Add event</CardTitle><CardDescription>Only teachers can manage calendar events.</CardDescription></CardHeader><CardContent><div className="flex flex-col gap-3"><label className="flex flex-col gap-1 text-sm">Event title<input value={title} onChange={lambda (e: ChangeEvent) { title = e.target.value; }} placeholder="Class assembly" className="h-10 rounded-lg border bg-background px-3" /></label><label className="flex flex-col gap-1 text-sm">Date<input type="text" value={event_date} onChange={lambda (e: ChangeEvent) { event_date = e.target.value; }} placeholder="2026-10-19" className="h-10 rounded-lg border bg-background px-3" /></label><label className="flex flex-col gap-1 text-sm">Details<input value={details} onChange={lambda (e: ChangeEvent) { details = e.target.value; }} placeholder="A short note for families" className="h-10 rounded-lg border bg-background px-3" /></label><Button onClick={save_event}><HugeiconsIcon icon={Add01Icon} strokeWidth={2} className="size-4" />Add school event</Button>{message and <p className="text-xs text-muted-foreground">{message}</p>}</div></CardContent></Card>}</div></div></main></div></div>;
}
