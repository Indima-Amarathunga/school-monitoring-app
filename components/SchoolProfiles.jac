import from "@jac/runtime" { Link }
import from .ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }

def:pub SchoolProfiles() -> JsxElement {
    has role: str = "";
    has profile_name: str = "Alex Patel";
    has phone: str = "555-0142";
    has address: str = "18 Garden Lane, Oakwood";
    has saved: bool = False;
    async can with entry {
        saved_role = sessionStorage.getItem("schoolhouse_demo_role");
        role = saved_role or "Parent";
        profile_key = "schoolhouse_teacher_profile_" if saved_role == "Teacher" else "schoolhouse_parent_profile_";
        saved_name = sessionStorage.getItem(profile_key + "name");
        if saved_name { profile_name = saved_name; }
        saved_phone = sessionStorage.getItem(profile_key + "phone");
        if saved_phone { phone = saved_phone; }
        saved_address = sessionStorage.getItem(profile_key + "address");
        if saved_address { address = saved_address; }
    }
    def save_profile {
        profile_key = "schoolhouse_teacher_profile_" if role == "Teacher" else "schoolhouse_parent_profile_";
        sessionStorage.setItem(profile_key + "name", profile_name);
        sessionStorage.setItem(profile_key + "phone", phone);
        sessionStorage.setItem(profile_key + "address", address);
        saved = True;
    }
    if role == "" { return <main className="min-h-screen bg-muted/40 p-8"><p className="text-sm text-muted-foreground">Loading profile…</p></main>; }
    display_name = "Lin Chen" if role == "Teacher" and profile_name == "Alex Patel" else profile_name;
    display_phone = "555-0108" if role == "Teacher" and phone == "555-0142" else phone;
    display_address = "240 Elm Street, Oakwood" if role == "Teacher" and address == "18 Garden Lane, Oakwood" else address;
    return <div className="min-h-screen bg-muted/40"><div className="mx-auto flex min-h-screen max-w-[1440px]"><aside className="hidden w-64 shrink-0 flex-col border-r bg-card px-5 py-6 md:flex"><Link to="/" className="mb-8 flex items-center gap-3"><span className="flex size-10 items-center justify-center rounded-xl bg-primary font-semibold text-primary-foreground">S</span><span><span className="block font-semibold">Schoolhouse</span><span className="block text-xs text-muted-foreground">{role == "Parent" and "Family portal" or "Teacher workspace"}</span></span></Link><nav className="flex flex-col gap-1"><Link to="/" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Overview</Link>{role == "Teacher" and <Link to="/students" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Students</Link>}<Link to="/progress" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning progress</Link><Link to="/homework" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Homework</Link><Link to="/calendar" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Calendar</Link><Link to="/notices" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Notices</Link><Link to="/messages" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Messages</Link><Link to="/profiles" className="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-medium text-primary">{role == "Parent" and "Child & family profile" or "My profile"}</Link><Link to="/materials" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning materials</Link><Link to="/event-media" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Event media</Link></nav></aside><main className="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-9 lg:py-8"><header className="mb-8 flex items-center justify-between"><Link to="/" className="font-semibold md:hidden">Schoolhouse</Link><span className="rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-900">Demo preview · {role}</span></header><div className="mb-6"><p className="text-sm font-medium text-primary">{role == "Parent" and "Your child’s school record" or "Account"}</p><h1 className="mt-1 text-3xl font-semibold tracking-tight">{role == "Parent" and "Maya’s profile" or "My profile"}</h1><p className="mt-1 text-sm text-muted-foreground">{role == "Parent" and "Your parent account opens your child’s profile and family contacts." or "Update your own teacher contact details."}</p></div>{role == "Parent" and <div className="grid gap-5 xl:grid-cols-2"><Card className="shadow-sm"><CardHeader><CardTitle>Student profile</CardTitle><CardDescription>The child record linked to the signed-in parent</CardDescription></CardHeader><CardContent><div className="flex items-center gap-4"><div className="flex size-16 items-center justify-center rounded-2xl bg-amber-100 text-xl font-semibold text-amber-900">MP</div><div><h2 className="text-xl font-semibold">Maya Patel</h2><p className="text-sm text-muted-foreground">Grade 3 · Room 12 · Oakwood Primary</p></div></div><dl className="mt-5 grid gap-4 border-t pt-5 sm:grid-cols-2"><div><dt className="text-xs text-muted-foreground">Date of birth</dt><dd className="mt-1 text-sm font-medium">12 March 2017</dd></div><div><dt className="text-xs text-muted-foreground">Student register number</dt><dd className="mt-1 text-sm font-medium">03121</dd></div><div><dt className="text-xs text-muted-foreground">Academic year</dt><dd className="mt-1 text-sm font-medium">2024–25</dd></div><div><dt className="text-xs text-muted-foreground">Medical notes</dt><dd className="mt-1 text-sm font-medium">No conditions recorded</dd></div><div className="sm:col-span-2"><dt className="text-xs text-muted-foreground">Home address</dt><dd className="mt-1 text-sm font-medium">{address}</dd></div></dl></CardContent></Card><Card className="shadow-sm"><CardHeader><CardTitle>Parents and guardians</CardTitle><CardDescription>Family contacts linked to Maya’s profile</CardDescription></CardHeader><CardContent><div className="flex flex-col gap-4"><div className="rounded-xl bg-primary/5 p-4"><p className="font-medium">{display_name} · Parent / guardian</p><a className="mt-1 inline-block text-sm text-primary" href="tel:+15550142">{display_phone}</a><p className="mt-1 text-xs text-muted-foreground">Primary family contact</p></div><div className="rounded-xl border p-4"><p className="font-medium">Sam Patel · Parent / guardian</p><a className="mt-1 inline-block text-sm text-primary" href="tel:+15550168">555-0168</a><p className="mt-1 text-xs text-muted-foreground">Additional family contact</p></div></div><div className="mt-5 border-t pt-4"><p className="text-sm font-medium">Class teacher · Ms. Lin Chen</p><p className="mt-1 text-xs text-muted-foreground">Public school contact</p><a className="mt-2 inline-block text-sm font-medium text-primary" href="tel:+15550108">555-0108</a><p className="mt-1 text-xs text-muted-foreground">Oakwood Primary · 240 Elm Street</p></div></CardContent></Card><Card className="shadow-sm xl:col-span-2"><CardHeader><CardTitle>Parent account contact details</CardTitle><CardDescription>Edit your own details here. These contacts are linked to Maya’s school record.</CardDescription></CardHeader><CardContent><div className="grid gap-4 sm:grid-cols-2"><label className="flex flex-col gap-1 text-sm font-medium">Parent name<input value={display_name} onChange={lambda (e: ChangeEvent) { profile_name = e.target.value; saved = False; }} className="h-10 rounded-lg border bg-background px-3 font-normal" /></label><label className="flex flex-col gap-1 text-sm font-medium">Your contact number<input value={display_phone} onChange={lambda (e: ChangeEvent) { phone = e.target.value; saved = False; }} className="h-10 rounded-lg border bg-background px-3 font-normal" /></label><label className="flex flex-col gap-1 text-sm font-medium sm:col-span-2">Family address<input value={display_address} onChange={lambda (e: ChangeEvent) { address = e.target.value; saved = False; }} className="h-10 rounded-lg border bg-background px-3 font-normal" /></label></div><button onClick={save_profile} className="mt-4 rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground">Save parent contact</button>{saved and <p className="mt-3 text-sm text-emerald-700">Parent contact changes saved in this browser session.</p>}</CardContent></Card></div>}{role == "Teacher" and <div className="grid gap-5 lg:grid-cols-2"><Card className="shadow-sm"><CardHeader><CardTitle>Teacher profile</CardTitle><CardDescription>Only your own teacher details are editable here.</CardDescription></CardHeader><CardContent><div className="flex flex-col gap-4"><label className="flex flex-col gap-1 text-sm font-medium">Teacher name<input value={display_name} onChange={lambda (e: ChangeEvent) { profile_name = e.target.value; saved = False; }} className="h-10 rounded-lg border bg-background px-3 font-normal" /></label><label className="flex flex-col gap-1 text-sm font-medium">Contact number<input value={display_phone} onChange={lambda (e: ChangeEvent) { phone = e.target.value; saved = False; }} className="h-10 rounded-lg border bg-background px-3 font-normal" /></label><label className="flex flex-col gap-1 text-sm font-medium">Address<input value={display_address} onChange={lambda (e: ChangeEvent) { address = e.target.value; saved = False; }} className="h-10 rounded-lg border bg-background px-3 font-normal" /></label><button onClick={save_profile} className="rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground">Save teacher profile</button>{saved and <p className="text-sm text-emerald-700">Teacher profile changes saved in this browser session.</p>}</div></CardContent></Card><Card className="shadow-sm"><CardHeader><CardTitle>Class access</CardTitle><CardDescription>Teacher workspace</CardDescription></CardHeader><CardContent><p className="text-sm text-muted-foreground">Review progress and assignments for students in your class.</p><Link to="/students" className="mt-5 inline-flex rounded-lg border px-4 py-2 text-sm font-medium hover:bg-muted">Open student roster</Link></CardContent></Card></div>}<p className="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs leading-relaxed text-amber-950">This is a demo role selector, not account authentication. Parent-child linking and role restrictions here are preview behavior only; production use requires authenticated accounts and server-enforced permissions.</p></main></div></div>;
}
