import from "@jac/runtime" { Link }
import from .ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }
import from "@hugeicons/react" { HugeiconsIcon }
import from "@hugeicons/core-free-icons" { Home01Icon, UserGroupIcon }

def:pub SchoolProfiles() -> JsxElement {
    return <div className="min-h-screen bg-muted/40"><div className="mx-auto flex min-h-screen max-w-[1440px]"><aside className="hidden w-64 shrink-0 flex-col border-r bg-card px-5 py-6 md:flex"><Link to="/" className="mb-9 flex items-center gap-3 px-1"><span className="flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5" /></span><span><span className="block font-semibold">Schoolhouse</span><span className="block text-xs text-muted-foreground">Family portal</span></span></Link><nav className="flex flex-col gap-1"><Link to="/" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Overview</Link><Link to="/progress" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning progress</Link><Link to="/homework" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Homework</Link><Link to="/calendar" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Calendar</Link><Link to="/notices" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Notices</Link><Link to="/messages" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Messages</Link><Link to="/profiles" className="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-medium text-primary">Profiles</Link><Link to="/materials" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning materials</Link><Link to="/event-media" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Event media</Link></nav></aside><main className="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-9 lg:py-8"><header className="mb-8"><Link to="/" className="flex items-center gap-2 font-semibold md:hidden"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5 text-primary" />Schoolhouse</Link><p className="text-sm text-muted-foreground">Oakwood Primary · Academic year 2024–25</p></header><div className="mb-6"><p className="text-sm font-medium text-primary">Family record</p><h1 className="mt-1 text-3xl font-semibold tracking-tight">Student and teacher profiles</h1><p className="mt-1 text-sm text-muted-foreground">Contact and school information for Maya’s support team.</p></div><div className="grid gap-5 xl:grid-cols-2"><Card className="shadow-sm"><CardHeader><CardTitle>Student profile</CardTitle><CardDescription>Core details and authorised parent contacts</CardDescription></CardHeader><CardContent><div className="flex items-center gap-4"><div className="flex size-16 items-center justify-center rounded-2xl bg-amber-100 text-xl font-semibold text-amber-900">MP</div><div><h2 className="text-xl font-semibold">Maya Patel</h2><p className="text-sm text-muted-foreground">Grade 3 · Room 12 · Student ID 03124</p></div></div><dl className="mt-5 grid gap-x-6 gap-y-4 border-t pt-5 sm:grid-cols-2"><div><dt className="text-xs text-muted-foreground">Date of birth</dt><dd className="mt-1 text-sm font-medium">12 March 2017</dd></div><div><dt className="text-xs text-muted-foreground">Academic year</dt><dd className="mt-1 text-sm font-medium">2024–25</dd></div><div><dt className="text-xs text-muted-foreground">Parent / guardian</dt><dd className="mt-1 text-sm font-medium">Alex Patel · 555-0142</dd></div><div><dt className="text-xs text-muted-foreground">Second contact</dt><dd className="mt-1 text-sm font-medium">Sam Patel · 555-0168</dd></div><div><dt className="text-xs text-muted-foreground">Home address</dt><dd className="mt-1 text-sm font-medium">18 Garden Lane, Oakwood</dd></div><div><dt className="text-xs text-muted-foreground">Medical notes</dt><dd className="mt-1 text-sm font-medium">No conditions recorded</dd></div></dl><div className="mt-5 rounded-xl bg-muted/50 p-4"><p className="text-sm font-medium">Privacy note</p><p className="mt-1 text-xs leading-relaxed text-muted-foreground">Student details are sensitive. Only authorised family members and school staff should access this record.</p></div></CardContent></Card><Card className="shadow-sm"><CardHeader><CardTitle>Class teacher</CardTitle><CardDescription>Teacher profile and school contact</CardDescription></CardHeader><CardContent><div className="flex items-center gap-4"><div className="flex size-16 items-center justify-center rounded-2xl bg-primary/10 text-xl font-semibold text-primary">LC</div><div><h2 className="text-xl font-semibold">Ms. Lin Chen</h2><p className="text-sm text-muted-foreground">Class teacher · Grade 3</p></div></div><dl className="mt-5 grid gap-x-6 gap-y-4 border-t pt-5 sm:grid-cols-2"><div><dt className="text-xs text-muted-foreground">Contact number</dt><dd className="mt-1 text-sm font-medium"><a className="text-primary" href="tel:+15550108">555-0108</a></dd></div><div><dt className="text-xs text-muted-foreground">Birthday</dt><dd className="mt-1 text-sm font-medium">8 September</dd></div><div className="sm:col-span-2"><dt className="text-xs text-muted-foreground">School</dt><dd className="mt-1 text-sm font-medium">Oakwood Primary School</dd></div><div className="sm:col-span-2"><dt className="text-xs text-muted-foreground">School address</dt><dd className="mt-1 text-sm font-medium">240 Elm Street, Oakwood</dd></div></dl><Link to="/messages" className="mt-5 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground"><HugeiconsIcon icon={UserGroupIcon} strokeWidth={2} className="size-4" />Contact the teacher</Link></CardContent></Card></div></main></div></div>;
}
