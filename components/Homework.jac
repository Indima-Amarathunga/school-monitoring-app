import from "@jac/runtime" { Link }
import from .ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }
import from "@hugeicons/react" { HugeiconsIcon }
import from "@hugeicons/core-free-icons" { Home01Icon, BookOpen01Icon, Clock01Icon, CheckmarkCircle02Icon }

def:pub Homework() -> JsxElement {
    return <div className="min-h-screen bg-muted/40"><div className="mx-auto flex min-h-screen max-w-[1440px]"><aside className="hidden w-64 shrink-0 flex-col border-r bg-card px-5 py-6 md:flex"><Link to="/" className="mb-9 flex items-center gap-3 px-1"><span className="flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5" /></span><span><span className="block font-semibold">Schoolhouse</span><span className="block text-xs text-muted-foreground">Family portal</span></span></Link><nav className="flex flex-col gap-1"><Link to="/" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Overview</Link><Link to="/progress" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning progress</Link><Link to="/homework" className="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-medium text-primary">Homework</Link><Link to="/calendar" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Calendar</Link><Link to="/notices" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Notices</Link><Link to="/messages" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Messages</Link><Link to="/profiles" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Profiles</Link><Link to="/materials" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning materials</Link><Link to="/event-media" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Event media</Link></nav></aside><main className="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-9 lg:py-8"><header className="mb-8"><Link to="/" className="flex items-center gap-2 font-semibold md:hidden"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5 text-primary" />Schoolhouse</Link><p className="text-sm text-muted-foreground">Maya Patel · Grade 3, Room 12</p></header><div className="mb-6"><p className="text-sm font-medium text-primary">Schoolwork</p><h1 className="mt-1 text-3xl font-semibold tracking-tight">Homework</h1><p className="mt-1 text-sm text-muted-foreground">Assignments, deadlines, and home-school review.</p></div><div className="grid gap-4 md:grid-cols-3"><Card className="shadow-sm"><CardContent><p className="text-sm text-muted-foreground">Assigned this week</p><p className="mt-2 text-3xl font-semibold">10</p></CardContent></Card><Card className="shadow-sm"><CardContent><p className="text-sm text-muted-foreground">Completed</p><p className="mt-2 text-3xl font-semibold">8</p></CardContent></Card><Card className="shadow-sm"><CardContent><p className="text-sm text-muted-foreground">Needs attention</p><p className="mt-2 text-3xl font-semibold">2</p></CardContent></Card></div><Card className="mt-5 shadow-sm"><CardHeader><CardTitle>Assignments</CardTitle><CardDescription>Review progress together and contact the teacher with questions.</CardDescription></CardHeader><CardContent className="flex flex-col gap-4"><div className="rounded-xl border p-4"><div className="flex flex-wrap items-start justify-between gap-3"><div className="flex items-start gap-3"><HugeiconsIcon icon={BookOpen01Icon} strokeWidth={2} className="mt-1 size-5 text-primary" /><div><h2 className="font-medium">Subtraction practice</h2><p className="text-sm text-muted-foreground">Mathematics · Complete exercises 1–10</p></div></div><span className="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-medium text-amber-900">Pending</span></div><div className="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-muted-foreground"><span>Assigned 17 October</span><span className="flex items-center gap-1"><HugeiconsIcon icon={Clock01Icon} strokeWidth={2} className="size-3.5" />Due 19 October</span></div><div className="mt-4 grid gap-2 border-t pt-3 text-sm sm:grid-cols-3"><p className="text-muted-foreground">Student completed: Not yet</p><p className="text-muted-foreground">Parent reviewed: Not yet</p><p className="text-muted-foreground">Teacher checked: Not yet</p></div></div><div className="rounded-xl border p-4"><div className="flex flex-wrap items-start justify-between gap-3"><div className="flex items-start gap-3"><HugeiconsIcon icon={BookOpen01Icon} strokeWidth={2} className="mt-1 size-5 text-primary" /><div><h2 className="font-medium">Read chapter four</h2><p className="text-sm text-muted-foreground">Language · The Garden Path</p></div></div><span className="rounded-full bg-muted px-2.5 py-1 text-xs font-medium">Started</span></div><div className="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-muted-foreground"><span>Assigned 17 October</span><span className="flex items-center gap-1"><HugeiconsIcon icon={Clock01Icon} strokeWidth={2} className="size-3.5" />Due 21 October</span></div></div><div className="rounded-xl border border-primary/20 bg-primary/5 p-4"><div className="flex items-center gap-2 text-sm font-medium"><HugeiconsIcon icon={CheckmarkCircle02Icon} strokeWidth={2} className="size-4 text-primary" />Teacher feedback</div><p className="mt-2 text-sm text-muted-foreground">Maya is making steady progress. Please encourage her to show each step in her mathematics workbook.</p></div></CardContent></Card></main></div></div>;
}
