import from "@jac/runtime" { Link }
import from .ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }
import from "@hugeicons/react" { HugeiconsIcon }
import from "@hugeicons/core-free-icons" { Home01Icon, BookOpen01Icon }

def:pub LearningProgress() -> JsxElement {
    return <div className="min-h-screen bg-muted/40"><div className="mx-auto flex min-h-screen max-w-[1440px]"><aside className="hidden w-64 shrink-0 flex-col border-r bg-card px-5 py-6 md:flex"><Link to="/" className="mb-9 flex items-center gap-3 px-1"><span className="flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5" /></span><span><span className="block font-semibold">Schoolhouse</span><span className="block text-xs text-muted-foreground">Family portal</span></span></Link><nav className="flex flex-col gap-1"><Link to="/" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Overview</Link><Link to="/progress" className="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-medium text-primary">Learning progress</Link><Link to="/homework" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Homework</Link><Link to="/calendar" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Calendar</Link><Link to="/notices" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Notices</Link><Link to="/messages" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Messages</Link><Link to="/profiles" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Profiles</Link><Link to="/materials" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning materials</Link><Link to="/event-media" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Event media</Link></nav></aside><main className="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-9 lg:py-8"><header className="mb-8 flex flex-wrap items-center justify-between gap-4"><Link to="/" className="flex items-center gap-2 font-semibold md:hidden"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5 text-primary" />Schoolhouse</Link><p className="text-sm text-muted-foreground">Maya Patel · Grade 3, Room 12 · Ms. Chen</p></header><div className="mb-6"><p className="text-sm font-medium text-primary">Academic growth</p><h1 className="mt-1 text-3xl font-semibold tracking-tight">Learning progress</h1><p className="mt-1 text-sm text-muted-foreground">Subject-by-subject strengths and next steps for home.</p></div><div className="grid gap-4 lg:grid-cols-2"><Card className="shadow-sm"><CardHeader><CardTitle>Mathematics</CardTitle><CardDescription>Building confidence · Latest assessment 8/10</CardDescription></CardHeader><CardContent><div className="h-2 overflow-hidden rounded-full bg-muted"><div className="h-full w-[72%] rounded-full bg-primary" /></div><p className="mt-4 text-sm"><strong>Strength:</strong> Maya understands addition and explains her approach clearly.</p><p className="mt-2 text-sm text-muted-foreground"><strong>Practice:</strong> Subtraction with borrowing, 10 minutes a day.</p><p className="mt-3 text-xs text-muted-foreground">Teacher note: Encourage her to show each step in her workbook.</p></CardContent></Card><Card className="shadow-sm"><CardHeader><CardTitle>Language</CardTitle><CardDescription>On track · Latest reading check: 4/5</CardDescription></CardHeader><CardContent><div className="h-2 overflow-hidden rounded-full bg-muted"><div className="h-full w-[84%] rounded-full bg-primary" /></div><p className="mt-4 text-sm"><strong>Strength:</strong> Enjoys reading aloud and retelling stories.</p><p className="mt-2 text-sm text-muted-foreground"><strong>Practice:</strong> Review spelling patterns from this week’s word list.</p><p className="mt-3 text-xs text-muted-foreground">Teacher note: A strong week of reading participation.</p></CardContent></Card><Card className="shadow-sm"><CardHeader><CardTitle>Science</CardTitle><CardDescription>Growing well · Activity observation</CardDescription></CardHeader><CardContent><div className="h-2 overflow-hidden rounded-full bg-muted"><div className="h-full w-[66%] rounded-full bg-primary" /></div><p className="mt-4 text-sm"><strong>Strength:</strong> Curious in class discussions and hands-on activities.</p><p className="mt-2 text-sm text-muted-foreground"><strong>Practice:</strong> Talk about what plants need to grow.</p></CardContent></Card><Card className="shadow-sm"><CardHeader><CardTitle>Social studies</CardTitle><CardDescription>Steady progress · Recent assignment complete</CardDescription></CardHeader><CardContent><div className="h-2 overflow-hidden rounded-full bg-muted"><div className="h-full w-[78%] rounded-full bg-primary" /></div><p className="mt-4 text-sm"><strong>Strength:</strong> Shares thoughtful connections to community topics.</p><p className="mt-2 text-sm text-muted-foreground"><strong>Next step:</strong> Practise summarising the main idea in one sentence.</p></CardContent></Card></div></main></div></div>;
}
