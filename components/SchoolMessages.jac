import from "@jac/runtime" { Link }
import from .ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }
import from "@hugeicons/react" { HugeiconsIcon }
import from "@hugeicons/core-free-icons" { Home01Icon, Message01Icon }

def:pub SchoolMessages() -> JsxElement {
    return <div className="min-h-screen bg-muted/40"><div className="mx-auto flex min-h-screen max-w-[1440px]"><aside className="hidden w-64 shrink-0 flex-col border-r bg-card px-5 py-6 md:flex"><Link to="/" className="mb-9 flex items-center gap-3 px-1"><span className="flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5" /></span><span><span className="block font-semibold">Schoolhouse</span><span className="block text-xs text-muted-foreground">Family portal</span></span></Link><nav className="flex flex-col gap-1"><Link to="/" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Overview</Link><Link to="/students" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Students</Link><Link to="/progress" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning progress</Link><Link to="/homework" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Homework</Link><Link to="/calendar" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Calendar</Link><Link to="/notices" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Notices</Link><Link to="/messages" className="rounded-lg bg-primary/10 px-3 py-2.5 text-sm font-medium text-primary">Messages</Link><Link to="/profiles" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Profiles</Link><Link to="/materials" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Learning materials</Link><Link to="/event-media" className="rounded-lg px-3 py-2.5 text-sm text-muted-foreground hover:bg-muted">Event media</Link></nav></aside><main className="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-9 lg:py-8"><header className="mb-8"><Link to="/" className="flex items-center gap-2 font-semibold md:hidden"><HugeiconsIcon icon={Home01Icon} strokeWidth={2} className="size-5 text-primary" />Schoolhouse</Link><p className="text-sm text-muted-foreground">Private conversation · Maya Patel’s family</p></header><div className="mb-6"><p className="text-sm font-medium text-primary">Home and school</p><h1 className="mt-1 text-3xl font-semibold tracking-tight">Messages</h1><p className="mt-1 text-sm text-muted-foreground">Keep questions and progress updates in one place.</p></div><Card className="shadow-sm"><CardHeader><CardTitle>Ms. Lin Chen</CardTitle><CardDescription>Class teacher · Grade 3 · Replies during school hours</CardDescription></CardHeader><CardContent><div className="flex min-h-64 flex-col gap-4 rounded-xl bg-muted/40 p-4"><div className="max-w-[85%] rounded-xl border bg-card p-4"><p className="text-xs font-medium text-primary">Ms. Chen · Today, 10:15 am</p><p className="mt-2 text-sm leading-relaxed">Maya showed great curiosity in our science activity. We are practising subtraction with borrowing this week. A few minutes of workbook practice at home would be helpful.</p></div><div className="ml-auto max-w-[85%] rounded-xl bg-primary/10 p-4"><p className="text-xs font-medium text-muted-foreground">Alex · Today, 11:02 am · Read</p><p className="mt-2 text-sm leading-relaxed">Thank you for the update. We’ll practise subtraction together this evening and ask Maya to explain her steps.</p></div><div className="max-w-[85%] rounded-xl border bg-card p-4"><p className="text-xs font-medium text-primary">Ms. Chen · Today, 11:20 am</p><p className="mt-2 text-sm leading-relaxed">That sounds like a great plan. Please let me know if she would benefit from extra practice materials.</p></div></div><div className="mt-4 rounded-xl border p-4"><label className="flex flex-col gap-2 text-sm font-medium">Your message<textarea placeholder="Write a note to Ms. Chen" rows={3} className="resize-y rounded-lg border bg-background p-3 text-sm font-normal" /></label><div className="mt-3 flex flex-wrap items-center justify-between gap-3"><span className="text-xs text-muted-foreground">Messages are private to this family and teacher.</span><button className="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">Send message</button></div></div></CardContent></Card><div className="mt-4 flex items-center gap-3 rounded-xl border bg-card p-4 text-sm text-muted-foreground"><HugeiconsIcon icon={Message01Icon} strokeWidth={2} className="size-5 shrink-0 text-primary" />For urgent absences or schedule changes, contact the school office directly.</div></main></div></div>;
}
